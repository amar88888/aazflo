// BizOps — schema portable (SQLite dev / PostgreSQL production).
// Sengaja tak guna enum supaya boleh tukar provider tanpa ubah schema —
// nilai tetap didefinisikan dalam src/lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Order {
  id              String      @id @default(cuid())
  platform        String // tiktok | shopee | woocommerce
  store           String      @default("maxlim") // kedai (multi-store woo): maxlim | facelim | ...
  platformOrderId String
  status          String // pending | printed | shipped | completed | cancelled
  buyerName       String?
  total           Float
  platformFee     Float       @default(0)
  shippingFee     Float       @default(0)
  // Bayaran (dari Woo): cara bayar + masa dibayar. COD = paymentMethod "cod".
  paymentMethod   String? // cod | chip | billplz | stripe | ...
  paymentTitle    String? // label Woo, cth "FPX / Kad"
  paidAt          DateTime? // Woo date_paid — null = belum bayar (COD dibayar masa terima)
  orderedAt       DateTime
  awbPrintedAt    DateTime?
  awbBatchId      String?
  awbBatch        AwbBatch?   @relation(fields: [awbBatchId], references: [id])
  items           OrderItem[]
  source          String      @default("csv") // csv | api

  // Penghantaran & tracking
  courier         String? // J&T Express | SPX Express | Pos Laju | Ninja Van | ...
  trackingNo      String?
  deliveryStatus  String      @default("pending") // pending | in_transit | out_for_delivery | delivered | failed | returned
  shippedAt       DateTime?
  deliveredAt     DateTime?
  trackingEvents  String? // JSON: [{stage, at}] — perjalanan parcel (dari courier)
  lastTrackingAt  DateTime? // masa event tracking terkini

  // Return / refund
  returnStatus    String      @default("none") // none | requested | approved | returned | refunded
  returnReason    String?
  refundAmount    Float       @default(0)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([platform, store, platformOrderId])
  @@index([platform, orderedAt])
  @@index([store])
  @@index([status])
  @@index([deliveryStatus])
  @@index([returnStatus])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku       String?
  name      String
  quantity  Int
  unitPrice Float
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([sku])
}

model Product {
  id          String      @id @default(cuid())
  name        String
  sku         String      @unique
  cogsPerUnit Float       @default(0)
  // Harga jual per platform (boleh berbeza antara platform)
  priceTiktok Float?
  priceShopee Float?
  priceWoo    Float?
  tiktokSku   String?
  shopeeSku   String?
  wooSku      String?
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model AwbBatch {
  id         String   @id @default(cuid())
  platform   String
  orderCount Int
  printedAt  DateTime @default(now())
  orders     Order[]
}

model Recording {
  id         String     @id @default(cuid())
  title      String
  fileRef    String? // path/nama fail video di PC user
  durationH  Float      @default(3)
  notes      String?
  slots      LiveSlot[]
  createdAt  DateTime   @default(now())
}

model LiveSlot {
  id          String     @id @default(cuid())
  startAt     DateTime
  endAt       DateTime
  recordingId String?
  recording   Recording? @relation(fields: [recordingId], references: [id])
  salesTotal  Float?
  peakViewers Int?
  notes       String?
  createdAt   DateTime   @default(now())

  @@index([startAt])
}

model Expense {
  id        String   @id @default(cuid())
  type      String // ads | fixed | other
  label     String
  amount    Float
  platform  String? // tiktok | shopee | woocommerce | null (umum)
  date      DateTime
  recurring Boolean  @default(false) // kos tetap bulanan
  createdAt DateTime @default(now())

  @@index([date])
  @@index([type])
}

model ApiCredential {
  id        String   @id @default(cuid())
  platform  String   @unique // shopee | tiktok | woocommerce | telegram
  data      String // JSON string (keys/tokens)
  updatedAt DateTime @updatedAt
}

// Konfigurasi umum (key-value) — cth: fee_tiktok, fee_shopee, fee_woo (peratus)
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ── Operasi Office ──

model Attendance {
  id         String   @id @default(cuid())
  date       DateTime
  partTimers Int      @default(0)
  names      String?
  wageTotal  Float    @default(0)
  notes      String?
  createdAt  DateTime @default(now())

  @@index([date])
}

model Supply {
  id           String   @id @default(cuid())
  name         String // Botol | Kotak | Bubble Wrap | Selotape | ...
  unit         String   @default("unit")
  currentStock Int      @default(0)
  reorderLevel Int      @default(0)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CashTxn {
  id          String   @id @default(cuid())
  date        DateTime
  type        String // topup | expense | claim
  category    String // lalamove | supplies | wage | other
  amount      Float
  description String?
  receiptPath String? // nama fail PDF dalam data/receipts
  createdAt   DateTime @default(now())

  @@index([date])
  @@index([type])
}

// ── Inbox WhatsApp (Cloud API rasmi) ──
// Satu kontak = satu perbualan. Mesej masuk via webhook, balas via Graph API
// (free-form sah dalam tetingkap 24 jam selepas mesej masuk terakhir).

model WaContact {
  id            String      @id @default(cuid())
  waId          String      @unique // WA: nombor 60123…; Messenger: "fb:<PSID>"; IG: "ig:<IGSID>"
  channel       String      @default("whatsapp") // whatsapp | messenger | instagram
  pageId        String? // Messenger/IG: page / IG account yang terima mesej (untuk balas)
  botPaused     Boolean     @default(false) // manusia ambil alih — bot berhenti untuk kontak ni
  needsHuman    Boolean     @default(false) // bot serahkan (komplen/refund/tak pasti)
  name          String? // nama profil WhatsApp (dari webhook)
  lastMessageAt DateTime? // mesej terakhir (arah mana pun) — untuk susun senarai
  lastInboundAt DateTime? // mesej MASUK terakhir — kira tetingkap 24 jam
  unread        Int         @default(0)
  archived      Boolean     @default(false)
  tag           String? // pemasaran | sokongan | ... (opsyenal)
  messages      WaMessage[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([lastMessageAt])
  @@index([archived])
}

model WaMessage {
  id        String    @id @default(cuid())
  contactId String
  contact   WaContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  waMsgId   String?   @unique // id mesej WhatsApp (wamid…) — elak duplikat
  direction String // in | out
  type      String    @default("text") // text | image | video | audio | document | sticker | button | interactive
  body      String? // teks / caption
  mediaId   String? // id media WA (kalau ada) — boleh tarik kemudian
  bot       Boolean   @default(false) // mesej keluar dihantar oleh bot AI
  status    String? // untuk mesej KELUAR: sent | delivered | read | failed
  error     String? // sebab gagal (kalau ada)
  timestamp DateTime // masa mesej
  createdAt DateTime  @default(now())

  @@index([contactId, timestamp])
}
