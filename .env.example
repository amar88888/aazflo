# Database (dev: SQLite. Untuk VPS/PostgreSQL, tukar provider dalam prisma/schema.prisma dulu)
DATABASE_URL="file:./dev.db"

# Auth — tukar sebelum deploy!
NEXTAUTH_SECRET="tukar-kepada-random-string-panjang"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@bizops.local"
ADMIN_PASSWORD="tukar-password-ni"
# Staff — akses terhad (AWB, tracking, return, print sahaja)
STAFF_EMAIL="staff@bizops.local"
STAFF_PASSWORD="tukar-password-staff"

# WooCommerce (isi selepas generate API key di WP Admin > WooCommerce > Settings > Advanced > REST API)
WOOCOMMERCE_URL=""
WOOCOMMERCE_CONSUMER_KEY=""
WOOCOMMERCE_CONSUMER_SECRET=""

# Base URL awam (untuk OAuth redirect) — production guna domain sebenar
APP_BASE_URL="http://localhost:3000"
# Kunci enkripsi token API tersimpan (jana: openssl rand -hex 32)
APP_ENCRYPTION_KEY=""

# TikTok Shop Partner API (Fasa 3 — dari partner.tiktokshop.com)
TIKTOK_APP_KEY=""
TIKTOK_APP_SECRET=""

# Shopee Open Platform (Fasa 3 — dari open.shopee.com)
SHOPEE_PARTNER_ID=""
SHOPEE_PARTNER_KEY=""
SHOPEE_REGION="MY"

# Telegram — report harian (@aazmsa_bot). Boleh set di Settings UI juga.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Rahsia untuk endpoint cron report harian (jana: openssl rand -hex 16)
CRON_SECRET="tukar-rahsia-cron-ni"

# Higgsfield — jana video AI (dari cloud.higgsfield.ai, format KEY_ID:KEY_SECRET)
HIGGSFIELD_CREDENTIALS=""
